{
 "doctype": "DocType",
 "name": "Menu Item",
 "module": "menu",
 "naming_rule": "By fieldname",
 "autoname": "field:item_name",
 "is_submittable": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "item_name",
   "label": "Dish Name (Hebrew)",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "item_name_en",
   "label": "Dish Name (English)",
   "fieldtype": "Data"
  },
  {
   "fieldname": "category",
   "label": "Category",
   "fieldtype": "Select",
   "options": "Soup\nSalad\nMain Course\nSide Dish\nDessert\nBeverage",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "ingredients",
   "label": "Recipe Ingredients",
   "fieldtype": "Table",
   "options": "Menu Item Ingredient",
   "reqd": 1
  },
  {
   "fieldname": "yield_portions",
   "label": "Yield (portions)",
   "fieldtype": "Int",
   "default": "1",
   "description": "How many portions this recipe produces"
  },
  {
   "fieldname": "packaging_cost",
   "label": "Packaging & Consumables Cost (ILS)",
   "fieldtype": "Currency",
   "precision": 2,
   "default": "0",
   "description": "עלות אריזה וחומרי לוואי למנה"
  },
  {
   "fieldname": "preparation_method",
   "label": "Preparation Method",
   "fieldtype": "Text",
   "description": "Brief description of cooking method"
  },
  {
   "fieldname": "is_active",
   "label": "Active",
   "fieldtype": "Check",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "calculated_base_cost",
   "label": "Calculated Base Cost (ILS)",
   "fieldtype": "Currency",
   "precision": 2,
   "read_only": 1,
   "description": "Auto-calculated from latest ingredient prices"
  },
  {
   "fieldname": "last_cost_update",
   "label": "Last Cost Update",
   "fieldtype": "Datetime",
   "read_only": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Stock Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_order": "ASC",
 "doctype": "DocType"
}
