{
 "doctype": "DocType",
 "name": "Daily Menu",
 "module": "menu",
 "naming_rule": "Expression",
 "autoname": "format:{menu_date}-{shift}",
 "is_submittable": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "menu_date",
   "label": "Menu Date",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "default": "Today"
  },
  {
   "fieldname": "shift",
   "label": "Shift",
   "fieldtype": "Select",
   "options": "Lunch\nDinner",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Draft\nPublished\nClosed",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "published_at",
   "label": "Published At",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "items",
   "label": "Menu Items",
   "fieldtype": "Table",
   "options": "Daily Menu Item"
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Small Text"
  }
 ],
 "sort_field": "menu_date",
 "sort_order": "DESC",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Stock Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_order": "DESC",
 "doctype": "DocType"
}
